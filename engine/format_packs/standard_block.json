{
  "pack_id": "standard_block",
  "name": "Standard Block Style",
  "description": "Multi-line structured block format with explicit key-value labels",
  "version": "1.0.0",
  "priority": 10,
  "style": "standard_block",
  "classification_markers": {
    "signal": ["\\b(BUY|SELL)\\b", "\\b(SL|TP|ENTRY)\\b"],
    "update": ["\\b(MODIFY|UPDATE|CLOSE|BREAKEVEN|BE)\\b"],
    "chatter_indicators": ["\\b(DISCLAIMER|JOIN|VIP|PROMO|LINK|HTTPS?://)\\b"]
  },
  "patterns": {
    "symbol": [
      "\\b([A-Z]{3}/?[A-Z]{3}|GOLD|XAUUSD|US30|DJ30|WS30|NAS100|USTEC|NDX|SPX500|US500|BTCUSD|ETHUSD|GER30|GER40|DAX|UK100|USOIL|WTI)\\b"
    ],
    "side": [
      "\\b(BUY|LONG)\\b",
      "\\b(SELL|SHORT)\\b"
    ],
    "order_type": {
      "limit": "\\b(LIMIT|BUY\\s+LIMIT|SELL\\s+LIMIT)\\b",
      "stop": "\\b(STOP|BUY\\s+STOP|SELL\\s+STOP)\\b(?!\\s*LOSS)"
    },
    "entry": [
      "(?:@|at|entry[:\\s]*|price[:\\s]*)\\s*([0-9]+\\.?[0-9]*)",
      "(?:entry|zone|price)[:\\s]*([0-9]+\\.?[0-9]*)\\s*-\\s*([0-9]+\\.?[0-9]*)"
    ],
    "stop_loss": [
      "(?:SL|STOP[\\s_-]?LOSS|STOP)[:\\s]*([0-9]+\\.?[0-9]*)",
      "(?:SL|STOP[\\s_-]?LOSS)\\s+TO\\s+([0-9]+\\.?[0-9]*)"
    ],
    "take_profit": [
      "(?:TP\\d?|TAKE[\\s_-]?PROFIT\\d?|TARGET\\d?)[:\\s]*([0-9]+\\.?[0-9]*)"
    ],
    "modifiers": {
      "partial_close": "(?:CLOSE|SECURE|BOOK)\\s*([0-9]+(?:\\.[0-9]+)?)\\s*%",
      "breakeven": "\\b(MOVE\\s+SL\\s+TO\\s+BE|SL\\s+TO\\s+BE|BREAKEVEN|RISK\\s+FREE)\\b",
      "full_close": "\\b(CLOSE\\s+ALL|CLOSE\\s+NOW|FULL\\s+CLOSE|EXIT\\s+NOW)\\b",
      "cancel_pending": "\\b(CANCEL\\s+ORDER|CANCEL\\s+PENDING|DELETE\\s+ORDER)\\b"
    }
  }
}
